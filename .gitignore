.claude/settings.local.json

# local secrets — never commit
.env
.env.local
.env.*.local

# local antigravity cli project symlink
.antigravitycli/

# build outputs — shipped as separate files on GitHub Releases, not committed.
# Rebuild locally with ./build.sh (or download them from a release).
*.skill
*.mcpb

# release staging
/dist/

# Dagger generated bindings (regenerated by `dagger develop` / at module load)
/.dagger/sdk/
**/__pycache__/

# macOS Finder metadata
.DS_Store
**/.DS_Store
